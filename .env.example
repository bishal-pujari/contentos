# Gemini backend: "vertex" (Google Cloud / aiplatform.googleapis.com, uses your
# GCP project + credits) or "developer" (Gemini Developer API with an API key).
# Auto-detected from GOOGLE_CLOUD_PROJECT when unset.
GEMINI_BACKEND=vertex

# Model id. Defaults: vertex -> gemini-2.5-flash, developer -> gemini-3.6-flash.
# Set explicitly to override the backend default.
# GEMINI_MODEL=gemini-2.5-flash

# --- Vertex AI backend (GEMINI_BACKEND=vertex) -------------------------------
# Auth uses Application Default Credentials. Either run:
#   gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# --- Gemini Developer API backend (GEMINI_BACKEND=developer) -----------------
GEMINI_API_KEY=your-gemini-key-here

# Per-run cap on Google Search grounded calls (0 = unlimited). On the Developer
# API free tier this mirrors the ~1500/day free search quota; on Vertex AI
# grounding is billed to your GCP project, so it acts as a self-imposed budget.
# Override per run with `rate-blogs --max-searches N`.
MAX_WEB_SEARCHES=1500

# DeepSeek direct API — fallback provider used when Gemini times out.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
